# Express API (copy to server/.env)
# Values below target local dev (npm run dev). docker-compose overrides the hostnames.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# MongoDB
MONGO_URI=mongodb://gramhealth:change_me_mongo@localhost:27017/gramhealth?authSource=admin

# TimescaleDB
TSDB_URL=postgres://gramhealth:change_me_tsdb@localhost:5433/vitals

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_VITALS_TOPIC=vitals/#

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Seed admin (created on first run if no admin exists)
SEED_ADMIN_EMAIL=admin@gramhealth.local
SEED_ADMIN_PASSWORD=change_me_admin

LOG_LEVEL=info
