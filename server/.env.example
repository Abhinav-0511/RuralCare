# Express API (copy to server/.env)
# Values below target local dev (npm run dev). docker-compose overrides the hostnames.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# MongoDB
MONGO_URI=mongodb://ruralcare:change_me_mongo@localhost:27017/ruralcare?authSource=admin

# TimescaleDB
TSDB_URL=postgres://ruralcare:change_me_tsdb@localhost:5433/vitals

# Vitals (Phase 4). Leave TSDB_URL empty to disable vitals; leave MQTT_URL empty to skip ingestion.
VITALS_RAW_RETENTION_DAYS=30

# MQTT: the server's read-only account. Must match MQTT_SERVER_USERNAME/PASSWORD in infra/.env.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=ruralcare-server
MQTT_PASSWORD=change_me_mqtt
MQTT_TOPIC_PREFIX=ruralcare/vitals
# Where the seed / `npm run devices:provision` write MQTT credentials (relative to server/).
# Mosquitto and the simulator read the same folder and reload by themselves.
MQTT_PROVISION_DIR=../infra/mosquitto/generated
SIMULATOR_DEVICES_FILE=../infra/mosquitto/generated/devices.json

# AI service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# Auth: at least 32 characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production while these still contain "change_me".
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Onboarding: forgot-password codes (OTP) and guest triage. All optional; these are the defaults.
# SMS_PROVIDER=console only logs the SMS (mock). A real gateway implements SmsSender (src/services/sms.ts).
SMS_PROVIDER=console
# Return the OTP in the API response so the app can show it. Defaults to on when NODE_ENV=development;
# the server refuses to start with it on in production.
# OTP_DEV_ECHO=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_PHONE_PER_HOUR=3
AUTH_RATE_LIMIT_PER_15MIN=20
GUEST_TRIAGE_RATE_LIMIT_PER_10MIN=30

# First admin, created on startup if no admin exists yet (login = phone + password).
# For full demo data instead, run: npm run seed -w @ruralcare/server
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=change_me_admin

LOG_LEVEL=info
