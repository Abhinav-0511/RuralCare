# MQTT vitals simulator (copy to edge/.env)
# Device credentials and topics come from devices.json, written by:
#   npm run devices:provision -w @ruralcare/server
DEVICES_FILE=devices.json

# Overrides the broker URL in devices.json (docker-compose sets mqtt://mosquitto:1883)
# MQTT_URL=mqtt://localhost:1883

PUBLISH_INTERVAL_SECONDS=5

# Probability (0-1) that a reading is a random abnormal one. 0 = only on demand via `inject`.
ABNORMAL_RATE=0
