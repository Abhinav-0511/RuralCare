# MQTT vitals simulator (copy to edge/.env)

MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=vitals
MQTT_CLIENT_ID_PREFIX=rc-sim

# Number of simulated devices and publish interval
DEVICE_COUNT=3
PUBLISH_INTERVAL_SECONDS=5

# Probability (0-1) that a reading is abnormal, for testing alerts
ABNORMAL_RATE=0.05
