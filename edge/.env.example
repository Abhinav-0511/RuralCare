# MQTT vitals simulator (copy to edge/.env)
# Device credentials and topics come from devices.json, written when the database is seeded
# (or by `npm run devices:provision -w @ruralcare/server`). The simulator waits for it and
# reconnects when it changes. docker-compose sets DEVICES_FILE=/app/generated/devices.json.
DEVICES_FILE=../infra/mosquitto/generated/devices.json

# Overrides the broker URL in devices.json (docker-compose sets mqtt://mosquitto:1883)
# MQTT_URL=mqtt://localhost:1883

PUBLISH_INTERVAL_SECONDS=5

# Probability (0-1) that a reading is a random abnormal one. 0 = only on demand via `inject`.
ABNORMAL_RATE=0
