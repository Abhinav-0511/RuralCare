# FastAPI AI service (copy to ai-service/.env)

APP_ENV=development
LOG_LEVEL=info

# Comma-separated origins allowed to call the service directly (normally only the server)
CORS_ORIGINS=http://localhost:4000

# Location of the repo's /shared folder (red-flag rules, symptom vocabulary, triage levels).
# Leave unset: locally it resolves to ../shared automatically, and the Docker image sets /shared.
# SHARED_DIR=

# ── Phase 3 (model) ──
# MODEL_PATH=models/triage_model.onnx
# MODEL_METADATA_PATH=models/model_metadata.json
# TRIAGE_MAPPING_PATH=models/disease_triage_map.json
# Predictions below this confidence are escalated to SEE_DOCTOR_SOON (never SELF_CARE)
# MIN_CONFIDENCE=0.6
