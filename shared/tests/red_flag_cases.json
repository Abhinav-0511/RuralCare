    {"name": "vomiting blood", "input": {"symptoms": ["vomiting_blood"]}, "expected": {"isEmergency": true, "matchedRuleIds": ["RF_SEVERE_BLEEDING"]}},
    {"name": "stroke: face drooping alone", "input": {"symptoms": ["face_drooping"]}, "expected": {"isEmergency": true, "matchedRuleIds": ["RF_STROKE_SIGNS"]}},
