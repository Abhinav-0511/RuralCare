    {"name": "vaginal bleeding, not pregnant", "input": {"symptoms": ["vaginal_bleeding"], "pregnant": false}, "expected": {"isEmergency": false, "matchedRuleIds": []}},
    {"name": "vaginal bleeding, pregnancy unknown", "input": {"symptoms": ["vaginal_bleeding"]}, "expected": {"isEmergency": false, "matchedRuleIds": []}},
