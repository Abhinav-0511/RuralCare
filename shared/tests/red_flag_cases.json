    {"name": "floor: fever with age known (adult) is not floored", "input": {"symptoms": ["mild_fever"], "ageMonths": 240}, "expected": {"isEmergency": false, "matchedRuleIds": [], "minimumLevel": null, "floorIds": []}},
    {"name": "floor + red flag: fever, age unknown, chest pain => EMERGENCY", "input": {"symptoms": ["high_fever", "chest_pain"]}, "expected": {"isEmergency": true, "matchedRuleIds": ["RF_CHEST_PAIN"], "minimumLevel": "EMERGENCY", "floorIds": ["FLOOR_FEVER_AGE_UNKNOWN"]}}
