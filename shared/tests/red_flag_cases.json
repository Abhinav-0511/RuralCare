    {"name": "unknown symptoms are ignored and reported", "input": {"symptoms": ["flying", "headache"]}, "expected": {"isEmergency": false, "matchedRuleIds": [], "unknownSymptoms": ["flying"]}},
    {"name": "floor: mild fever, age unknown", "input": {"symptoms": ["mild_fever", "cough"]}, "expected": {"isEmergency": false, "matchedRuleIds": [], "minimumLevel": "SEE_DOCTOR_24H", "floorIds": ["FLOOR_FEVER_AGE_UNKNOWN"]}},
    {"name": "floor: measured 38.5C, age unknown, no fever ticked", "input": {"symptoms": ["headache"], "temperatureC": 38.5}, "expected": {"isEmergency": false, "matchedRuleIds": [], "minimumLevel": "SEE_DOCTOR_24H", "floorIds": ["FLOOR_FEVER_AGE_UNKNOWN"]}},
    {"name": "floor: 37.5C, age unknown, no fever is not floored", "input": {"symptoms": ["headache"], "temperatureC": 37.5}, "expected": {"isEmergency": false, "matchedRuleIds": [], "minimumLevel": null, "floorIds": []}},
