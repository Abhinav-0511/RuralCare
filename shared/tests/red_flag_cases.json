    {"name": "boundary: 3-month-old with mild fever is not a young infant", "input": {"symptoms": ["mild_fever"], "ageMonths": 3}, "expected": {"isEmergency": false, "matchedRuleIds": []}},
    {"name": "mild fever 38.5C, 8-month-old", "input": {"symptoms": ["mild_fever"], "ageMonths": 8, "temperatureC": 38.5}, "expected": {"isEmergency": false, "matchedRuleIds": []}},
    {"name": "boundary: high fever at exactly 12 months", "input": {"symptoms": ["high_fever"], "ageMonths": 12}, "expected": {"isEmergency": false, "matchedRuleIds": []}},
    {"name": "high fever, adult", "input": {"symptoms": ["high_fever", "headache"], "ageMonths": 360}, "expected": {"isEmergency": false, "matchedRuleIds": [], "minimumLevel": null, "floorIds": []}},
