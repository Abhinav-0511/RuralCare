    {"name": "boundary: exactly 38.0C, 2-month-old", "input": {"symptoms": [], "ageMonths": 2, "temperatureC": 38.0}, "expected": {"isEmergency": true, "matchedRuleIds": ["RF_FEVER_YOUNG_INFANT"]}},
    {"name": "high fever, 2-month-old matches both infant rules", "input": {"symptoms": ["high_fever"], "ageMonths": 2}, "expected": {"isEmergency": true, "matchedRuleIds": ["RF_FEVER_YOUNG_INFANT", "RF_HIGH_FEVER_INFANT"]}},
