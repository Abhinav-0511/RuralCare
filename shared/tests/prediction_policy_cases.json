{
  "notes": "Golden cases for turning model output into a triage level (policy in shared/data/conditions.json). BOTH shared/src/model.ts and ai-service/app/model/policy.py must pass every case. 'ranked' is sorted by probability, highest first.",
  "cases": [
    { "name": "confident self-care condition", "ranked": [{ "id": "common_cold", "probability": 0.9 }, { "id": "allergy", "probability": 0.05 }], "knownFeatureCount": 3, "unmodelledSymptoms": [], "expected": { "level": "SELF_CARE", "lowConfidence": false } },
    { "name": "exactly at the confidence threshold is confident", "ranked": [{ "id": "common_cold", "probability": 0.6 }], "knownFeatureCount": 2, "unmodelledSymptoms": [], "expected": { "level": "SELF_CARE", "lowConfidence": false } },
    { "name": "low confidence never returns SELF_CARE", "ranked": [{ "id": "common_cold", "probability": 0.5 }, { "id": "allergy", "probability": 0.2 }], "knownFeatureCount": 2, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_SOON", "lowConfidence": true } },
    { "name": "low confidence does not lower a more severe level", "ranked": [{ "id": "dengue", "probability": 0.4 }, { "id": "malaria", "probability": 0.2 }], "knownFeatureCount": 3, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_24H", "lowConfidence": true } },
    { "name": "serious runner-up escalates the level", "ranked": [{ "id": "common_cold", "probability": 0.65 }, { "id": "dengue", "probability": 0.3 }], "knownFeatureCount": 4, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_24H", "lowConfidence": false } },
    { "name": "runner-up exactly at the escalation threshold escalates", "ranked": [{ "id": "common_cold", "probability": 0.7 }, { "id": "pneumonia", "probability": 0.25 }], "knownFeatureCount": 4, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_24H", "lowConfidence": false } },
    { "name": "runner-up below the escalation threshold is ignored", "ranked": [{ "id": "common_cold", "probability": 0.75 }, { "id": "dengue", "probability": 0.2 }], "knownFeatureCount": 4, "unmodelledSymptoms": [], "expected": { "level": "SELF_CARE", "lowConfidence": false } },
    { "name": "conditions outside the top 3 are ignored", "ranked": [{ "id": "common_cold", "probability": 0.3 }, { "id": "acne", "probability": 0.25 }, { "id": "allergy", "probability": 0.25 }, { "id": "dengue", "probability": 0.2 }], "knownFeatureCount": 2, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_SOON", "lowConfidence": true } },
    { "name": "same-level runner-up changes nothing", "ranked": [{ "id": "acne", "probability": 0.62 }, { "id": "allergy", "probability": 0.3 }], "knownFeatureCount": 3, "unmodelledSymptoms": [], "expected": { "level": "SELF_CARE", "lowConfidence": false } },
    { "name": "a symptom the model can't see blocks SELF_CARE", "ranked": [{ "id": "common_cold", "probability": 0.95 }], "knownFeatureCount": 3, "unmodelledSymptoms": ["vaginal_bleeding"], "expected": { "level": "SEE_DOCTOR_SOON", "lowConfidence": false } },
    { "name": "no symptom the model knows => SEE_DOCTOR_SOON", "ranked": [{ "id": "fungal_infection", "probability": 0.4 }], "knownFeatureCount": 0, "unmodelledSymptoms": ["vaginal_bleeding"], "expected": { "level": "SEE_DOCTOR_SOON", "lowConfidence": true } },
    { "name": "confident 24h condition", "ranked": [{ "id": "typhoid", "probability": 0.88 }], "knownFeatureCount": 5, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_24H", "lowConfidence": false } },
    { "name": "confident see-soon condition", "ranked": [{ "id": "urinary_tract_infection", "probability": 0.81 }, { "id": "common_cold", "probability": 0.1 }], "knownFeatureCount": 3, "unmodelledSymptoms": [], "expected": { "level": "SEE_DOCTOR_SOON", "lowConfidence": false } }
  ]
}
