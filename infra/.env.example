# Used by infra/docker-compose.yml (copy to infra/.env)

# MongoDB
MONGO_ROOT_USERNAME=gramhealth
MONGO_ROOT_PASSWORD=change_me_mongo
MONGO_DB=gramhealth
MONGO_PORT=27017

# TimescaleDB (host port 5433 to avoid clashing with a local Postgres)
TSDB_USER=gramhealth
TSDB_PASSWORD=change_me_tsdb
TSDB_DB=vitals
TSDB_PORT=5433

# Mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001

# App ports
SERVER_PORT=4000
AI_PORT=8000
CLIENT_PORT=8080

# URL the browser uses to reach the API (baked into the client build)
CLIENT_API_URL=http://localhost:4000
