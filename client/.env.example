# React PWA (copy to client/.env)
# Only VITE_* variables are exposed to the browser. They are baked in at build time,
# so never put secrets here.

VITE_API_URL=http://localhost:4000
VITE_DEFAULT_LOCALE=en
VITE_SUPPORTED_LOCALES=en,ta,hi

# Where the PWA downloads the ONNX model from (served by the API, cached by the service worker)
VITE_MODEL_URL=/models/triage_model.onnx

VITE_EMERGENCY_NUMBER=108
